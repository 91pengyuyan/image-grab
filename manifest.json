{
  "manifest_version": 3,
  "name": "图提取 - 电商图片下载助手",
  "version": "1.1.0",
  "description": "一键提取淘宝、京东、拼多多商品详情页所有图片，批量下载为PNG格式",
  "permissions": ["storage", "downloads", "scripting"],
  "host_permissions": [
    "*://item.taobao.com/*",
    "*://detail.tmall.com/*",
    "*://*.tmall.com/*",
    "*://item.jd.com/*",
    "*://*.jd.com/*",
    "*://*.pinduoduo.com/*",
    "*://*.yangkeduo.com/*",
    "*://*.alicdn.com/*",
    "*://*.taobaocdn.com/*",
    "*://*.360buyimg.com/*",
    "*://*.pddpic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://item.taobao.com/*",
        "*://detail.tmall.com/*",
        "*://*.tmall.com/item.htm*",
        "*://item.jd.com/*",
        "*://item.m.jd.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*",
        "*://*.alicdn.com/*",
        "*://*.taobaocdn.com/*"
      ],
      "js": [
        "extractors/url.js",
        "extractors/taobao.js",
        "extractors/jd.js",
        "extractors/pdd.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "图提取",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["gallery.html", "gallery.js", "gallery.css"],
      "matches": [
        "*://item.taobao.com/*",
        "*://detail.tmall.com/*",
        "*://*.tmall.com/*",
        "*://item.jd.com/*",
        "*://*.jd.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ]
    }
  ]
}
